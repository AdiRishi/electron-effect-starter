{
  "extends": "@app/tsconfig/base.json",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@vitest/browser-playwright"],
    "paths": {
      "~/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Diagnostic severities deep-merge with @app/tsconfig/base.json; list only browser overrides here.
        "diagnosticSeverity": {
          "globalDate": "off",
          "globalConsole": "off",
          "globalRandom": "off",
          "globalTimers": "off",
          "globalFetch": "off"
        }
      }
    ]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
