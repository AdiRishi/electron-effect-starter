{
  "name": "electron-effect-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "node tooling/scripts/dev-runner.ts dev",
    "dev:server": "node tooling/scripts/dev-runner.ts dev:server",
    "dev:web": "node tooling/scripts/dev-runner.ts dev:web",
    "dev:desktop": "node tooling/scripts/dev-runner.ts dev:desktop",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=@app/desktop",
    "start:desktop": "pnpm --filter @app/desktop start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint --disable-nested-config --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --disable-nested-config --report-unused-disable-directives",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check",
    "dist:desktop": "node tooling/scripts/build-desktop-artifact.ts",
    "sync:repos": "git subtree pull --prefix=repos/effect https://github.com/Effect-TS/effect.git main --squash",
    "clean": "rm -rf node_modules .turbo apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron release"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "pnpm@12.15.0"
}
